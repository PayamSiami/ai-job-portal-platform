# ============================================================
# One Dockerfile for every service. Build context = platform
# root, SERVICE selects the workspace to build & run.
#   docker build -f infra/Dockerfile.service --build-arg SERVICE=auth-service .
# ============================================================

FROM node:22-alpine AS build
WORKDIR /app
ARG SERVICE

COPY package.json package-lock.json* ./
COPY tsconfig.base.json ./
COPY packages ./packages
COPY services ./services

RUN npm ci || npm install
RUN npm run build -w @portal/shared && npm run build -w services/$SERVICE

FROM node:22-alpine
WORKDIR /app
ARG SERVICE
ENV SERVICE=${SERVICE}
ENV NODE_ENV=production

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/services/${SERVICE}/package.json ./services/${SERVICE}/package.json
COPY --from=build /app/services/${SERVICE}/dist ./services/${SERVICE}/dist

CMD ["sh", "-c", "node services/$SERVICE/dist/index.js"]
