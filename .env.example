# ============================================================
# Copy to .env (local dev) or feed your secret manager in prod.
# NEVER commit the filled file.
# ============================================================

# --- Core ---
NODE_ENV=development

# --- Security (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_SECRET=CHANGE_ME_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_different_from_access
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
# Shared secret required on x-internal-token for /internal/* endpoints
INTERNAL_API_TOKEN=CHANGE_ME_random_internal_token

# --- Datastores (dev defaults; compose overrides host names) ---
MONGODB_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# --- Service URLs (dev: localhost; compose: container names) ---
AUTH_SERVICE_URL=http://localhost:8001
JOB_SERVICE_URL=http://localhost:8002
APPLICATION_SERVICE_URL=http://localhost:8003
RESUME_SERVICE_URL=http://localhost:8004
COMPANY_SERVICE_URL=http://localhost:8005
AI_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007
INTERVIEW_SERVICE_URL=http://localhost:8008

# --- Gateway ---
GATEWAY_PORT=8000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- AI (single place where AI keys live) ---
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Google OAuth (auth-service) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP (notification-service); leave SMTP_HOST empty to log emails to console ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Job Portal <no-reply@jobmatch.ir>"
